TZ=Europe/Prague

# Host port na LXC. Uvnitř kontejneru zůstává 9050 (healthcheck).
TOR_SOCKS_PORT=9050

# Tor addr-policy. Přesné VLAN CIDR jen tady / v Portainer env, ne do gitu.
# 127.0.0.0/8 musí zůstat — healthcheck image jde na localhost:9050.
# Příklad dál RFC1918; zúž LAN na trusted. IoT/guest sem nepatří.
TOR_SOCKS_POLICY=accept 127.0.0.0/8,accept 10.0.0.0/8,accept 172.16.0.0/12,accept 192.168.0.0/16,reject *
