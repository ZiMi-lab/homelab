TZ=Europe/Prague

# Fine-grained PAT jen na repozitáře níže, Repository permissions → Administration: Read and write.
# Skutečná hodnota jen v Portainer env.
GH_RUNNER_PAT=github_pat_CHANGE_ME

# Tag oficiálního image. `latest` + „Re-pull image and redeploy“ v Portaineru = aktualizace.
RUNNER_IMAGE_TAG=latest

# Jeden runner = jeden repozitář (osobní účet nemá runnery organizace).
# Prázdné RUNNER_n_REPO nechá slot spát.
RUNNER_1_REPO=OWNER/REPO_1
RUNNER_1_NAME=runner-1
RUNNER_1_LABELS=ci

RUNNER_2_REPO=OWNER/REPO_2
RUNNER_2_NAME=runner-2
RUNNER_2_LABELS=ci
