# Připojení k TrueNAS bitcoind-knots z electrs/mempool.
# Zkopíruj na bitcoin/bitcoind-knots/.env (gitignored) nebo použij stejné klíče v bitcoin/electrs/.env.

TZ=Europe/Prague
BITCOIN_RPC_HOST=truenas.lan
BITCOIN_RPC_PORT=8332
BITCOIN_RPC_USER=truenas
BITCOIN_RPC_PASSWORD=
BITCOIN_P2P_HOST=truenas.lan
BITCOIN_P2P_PORT=8333
BITCOIN_DATA=/mnt/POOL/apps/bitcoind-knots
BITCOIN_ZMQ_RAWBLOCK=tcp://truenas.lan:28332
BITCOIN_ZMQ_RAWTX=tcp://truenas.lan:28333
