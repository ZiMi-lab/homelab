# Zkopíruj do .env mimo git, nebo exportuj v shellu.
# Nikdy necommituj vyplněné hodnoty.

# TrueNAS JSON-RPC (wss://host/api/current)
TRUENAS_URL=https://nas.example.cz
TRUENAS_API_USER=admin
TRUENAS_API_KEY=
TRUENAS_VERIFY_TLS=1

# Proxmox API token (PVEAuditor na čtení)
PVE_HOST=https://pve1.lan:8006
PVE_TOKEN_ID=agent@pve!cursor
PVE_TOKEN_SECRET=
