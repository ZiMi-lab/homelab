# ----------------------------------------
# 🔒 SECRETS & ENVIRONMENT VARIABLES
# ----------------------------------------
# Ignorovat VSECHNY .env soubory (v koreni a podadresari)
**/.env*

# VYJÍMKA: Povolit soubory .env.example
!.env.example
!**/.env.example

# ----------------------------------------
# ⚙️ SYSTEM & TEMPORARY FILES
# ----------------------------------------
.DS_Store
Thumbs.db

# ----------------------------------------
# 📦 DATA VOLUMES
# ----------------------------------------
# Ignoruje adresare 'data' a 'mysql' kdekoliv v projektu
**/data/
**/mysql/
**/db_data/
**/config/

# ----------------------------------------
# 🐳 DOCKER OVERRIDES & TEMPORARY
# ----------------------------------------
# Standardne generovane nebo lokalne modifikovane soubory
docker-compose.override.yml
**/docker-compose.override.yml

# ----------------------------------------
# 🗺️ SOUKROMÁ INVENTURA
# ----------------------------------------
inventory/hosts.local.yml

# ----------------------------------------
# ⛔ VÝVOJOVÉ A TESTOVACÍ ADRESÁŘE
# ----------------------------------------
# Ignoruje adresář /dev/ v kořeni (lokální exporty z Portaineru, scratch)
/dev/

# Ignoruje adresáře, které mají v nazvu "tmp" nebo "temp"
**/tmp/
**/temp/